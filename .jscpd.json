{
  "minLines": 5,
  "minTokens": 50,
  "mode": "mild",
  "pattern": "**/*.{js,mjs,cjs,jsx,ts,tsx,cs,py,rs,go,sh,ps1}",
  "formatsExts": { "javascript": ["js", "mjs", "cjs"] },
  "ignore": [
    "**/node_modules/**", "**/.git/**", "**/.quality-cache/**",
    "**/quality-reports/**", "**/megalinter-reports/**", "**/generated/**",
    "**/bin/**", "**/obj/**", "**/dist/**", "**/.output/**", "**/coverage/**"
  ]
}
