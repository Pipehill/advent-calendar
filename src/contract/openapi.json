{
  "openapi": "3.0.3",
  "info": {
    "title": "Advent calendar API",
    "version": "1.0.0",
    "description": "Create and retrieve persisted calendars. Initial endpoints require no user context.",
    "license": { "name": "Private" }
  },
  "servers": [{ "url": "http://localhost:8080" }],
  "tags": [{ "name": "calendars", "description": "Calendar creation and retrieval" }],
  "paths": {
    "/calendars": {
      "post": {
        "operationId": "Create",
        "summary": "Create a calendar",
        "tags": ["calendars"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateCalendarRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Persisted calendar with 24 doors",
            "headers": { "Location": { "description": "Retrieval path", "schema": { "type": "string" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CalendarDto" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/calendars/{id}": {
      "get": {
        "operationId": "Get",
        "summary": "Retrieve a calendar",
        "tags": ["calendars"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": {
            "description": "Persisted calendar",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CalendarDto" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/health/live": {
      "get": {
        "operationId": "Live",
        "summary": "Check process liveness",
        "tags": ["calendars"],
        "responses": { "200": { "description": "Process is live", "content": { "text/plain": { "schema": { "type": "string" } } } } }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "Ready",
        "summary": "Check migration completion and current database availability",
        "tags": ["calendars"],
        "responses": {
          "200": { "description": "Ready", "content": { "text/plain": { "schema": { "type": "string" } } } },
          "503": { "description": "Database unavailable", "content": { "text/plain": { "schema": { "type": "string" } } } }
        }
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": {
        "description": "Invalid body, UUID, or normalized title",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ApiProblemDetails" } } }
      },
      "NotFound": {
        "description": "Calendar does not exist",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ApiProblemDetails" } } }
      },
      "UnsupportedMediaType": {
        "description": "A JSON request body is required",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ApiProblemDetails" } } }
      },
      "ServerError": {
        "description": "Unexpected server or database failure",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ApiProblemDetails" } } }
      }
    },
    "schemas": {
      "CreateCalendarRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": {
            "type": "string",
            "nullable": false,
            "description": "Trim surrounding .NET Unicode whitespace before validation/storage. The trimmed value must contain 1-100 Unicode code points and no NUL (PostgreSQL text cannot store NUL). Combining marks and compound emoji components each count separately. Raw input has no minLength/maxLength so surrounding whitespace never invalidates a valid normalized title.",
            "x-normalized-minLength": 1,
            "x-normalized-maxLength": 100
          }
        }
      },
      "CalendarDto": {
        "type": "object",
        "required": ["id", "title", "doors", "createdAt", "lastModifiedAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid", "description": "UUID v4 generated by the service" },
          "title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "doors": { "type": "array", "minItems": 24, "maxItems": 24, "items": { "$ref": "#/components/schemas/DoorDto" } },
          "createdAt": { "type": "string", "format": "date-time", "description": "RFC 3339 UTC instant" },
          "lastModifiedAt": { "type": "string", "format": "date-time", "description": "RFC 3339 UTC instant" }
        }
      },
      "DoorDto": {
        "type": "object",
        "required": ["number", "text"],
        "properties": {
          "number": { "type": "integer", "format": "int32", "minimum": 1, "maximum": 24 },
          "text": { "type": "string", "nullable": false, "description": "Persisted contents; initially empty" }
        }
      },
      "ApiProblemDetails": {
        "type": "object",
        "required": ["type", "title", "status", "traceId", "errors"],
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "integer", "format": "int32", "minimum": 400, "maximum": 599 },
          "traceId": { "type": "string" },
          "errors": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } }
        }
      }
    }
  }
}
