    "securitySchemes": {
      "AuthCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "advent.auth",
        "description": "Backend-owned HttpOnly host-only persistent cookie. Fixed expiry; Secure outside Development/Testing."
      },
      "Antiforgery": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-TOKEN",
