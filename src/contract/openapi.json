{
  "openapi": "3.0.3",
  "info": {
    "title": "Advent calendar API",
    "version": "1.1.0",
    "description": "Backend username/password accounts and user management. Calendar endpoints remain anonymous pending separate authorization work. All authentication/user responses are no-store. Unsafe operations require the ASP.NET antiforgery cookie and X-CSRF-TOKEN header; refresh the token after a principal change. Production requires HTTPS.",
    "license": {
      "name": "Private"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "tags": [
    {
      "name": "calendars",
      "description": "Calendar creation and retrieval"
    },
    {
      "name": "auth",
      "description": "Fixed-expiry cookie sessions and CSRF exchange"
    },
    {
      "name": "users",
      "description": "Authorized account administration; no API superadmin provisioning"
    }
  ],
  "paths": {
    "/calendars": {
      "post": {
        "operationId": "Create",
        "summary": "Create a calendar",
        "tags": [
          "calendars"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCalendarRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Persisted calendar with 24 doors",
            "headers": {
              "Location": {
                "description": "Retrieval path",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarDto"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
