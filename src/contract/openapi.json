  "components": {
    "responses": {
      "BadRequest": {
        "description": "Invalid body, UUID, or normalized title",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ApiProblemDetails"
            }
          }
        }
      },
      "NotFound": {
        "description": "Calendar does not exist",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ApiProblemDetails"
            }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "A JSON request body is required",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ApiProblemDetails"
            }
          }
        }
      },
      "ServerError": {
        "description": "Unexpected server or database failure",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ApiProblemDetails"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Invalid credentials, session or expired temporary password; login does not disclose account existence.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ApiProblemDetails"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Insufficient authority, restricted session, invalid CSRF exchange or missing recent verification.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ApiProblemDetails"
            }
          }
        }
      },
      "Conflict": {
        "description": "Reserved username, stale verified state, unchanged replacement password or role/responsibility conflict.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ApiProblemDetails"
            }
          }
        }
      },
      "Throttled": {
        "description": "Account/IP/global resource budget reached.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ApiProblemDetails"
            }
          }
        }
      },
      "Unavailable": {
        "description": "Session validity persistence unavailable; access fails closed.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ApiProblemDetails"
            }
          }
        }
      }
    },
    "schemas": {
      "CreateCalendarRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "nullable": false,
            "description": "Trim surrounding .NET Unicode whitespace before validation/storage. The trimmed value must contain 1-100 Unicode code points and no NUL (PostgreSQL text cannot store NUL). Combining marks and compound emoji components each count separately. Raw input has no minLength/maxLength so surrounding whitespace never invalidates a valid normalized title.",
            "x-normalized-minLength": 1,
            "x-normalized-maxLength": 100
          }
        }
      },
      "CalendarDto": {
        "type": "object",
        "required": [
          "id",
          "title",
          "doors",
          "createdAt",
          "lastModifiedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
