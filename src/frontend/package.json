{
  "name": "calendar-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": { "node": ">=24.14.0 <25" },
  "scripts": {
    "generate": "node ../../tools/frontend/check.mjs generate",
    "dev": "node ../../tools/frontend/check.mjs generate && vite --host 0.0.0.0",
    "typecheck": "node ../../tools/frontend/check.mjs generate && vite build --mode typecheck && tsc --noEmit",
    "build": "node ../../tools/frontend/check.mjs generate && vite build && tsc --noEmit && node build-nitro.mjs",
    "start": "node .output/server/index.mjs",
    "test": "node ../../tools/frontend/check.mjs generate && vitest run",
    "lint": "biome check src vite.config.ts vitest.config.ts"
  },
  "dependencies": {
    "@tanstack/react-start": "1.169.1",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-query": "5.104.2",
    "@trpc/server": "11.19.0",
    "@trpc/client": "11.19.0",
    "@trpc/tanstack-react-query": "11.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "h3": "1.15.11"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.27.0",
    "@inlang/plugin-message-format": "4.5.2",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "typescript": "7.0.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "nitropack": "2.13.4",
    "@biomejs/biome": "2.5.15",
    "playwright": "1.64.0"
  }
}
